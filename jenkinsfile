pipeline{
    agent any
    stages{
        stage('Build'){
            steps{
                bat 'docker build -t myapp:latest .'
            }
        }
        stage('Test'){
            steps{
                bat 'docker rm -f mycontainer || exit 0'
                bat 'docker run -d 5000:5000 --name mycontainer mypythonflaskapp'
            }
    }
}
    post{
        success{
            echo 'Build and Test Successful!'
        }failure{
            echo 'Build or Test Failed!'
        }
    }

}